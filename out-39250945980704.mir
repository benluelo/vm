def load64(at) -> u {
  u <- read8(at)
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
}
def store64(at, u) {
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
  write8(at, u)
}
def xor64(at, u) {
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
  write8(at, xor(read8(at), u))
}
def ROTL64(a, offset) -> n {
  n <- xor(shl(a, offset), shr(a, sub(64, offset)))
}
def i(x, y) -> n {
  n <- add(x, mul(5, y))
}
def readLane(x, y) -> lane {
  lane <- load64(mul(8, add(x, mul(5, y))))
}
def writeLane(x, y, lane) {
  store64(mul(8, add(x, mul(5, y))), lane)
}
def XORLane(x, y, lane) {
  xor64(mul(8, add(x, mul(5, y))), lane)
}
