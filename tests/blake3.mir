def OUT_LEN() -> x { x <- 32 }     # usize
def BLOCK_LEN() -> x { x <- 64 }   # usize
def CHUNK_LEN() -> x { x <- 1024 } # usize

def CHUNK_START() -> x { x <- shl(1, 0) }         # u32
def CHUNK_END() -> x { x <- shl(1, 1) }           # u32
def PARENT() -> x { x <- shl(1, 2) }              # u32
def ROOT() -> x { x <- shl(1, 3) }                # u32

def copyWords(from, to, len) {
  i <- 0
  loop :copy {
    if eq(i, len) {
      break :copy
    }

    write4(add(to, mul(i, 4)), read4(add(from, mul(i, 4))))

    i <- add(i, 1)
  }
}

def zeroWords(words, len) {
  i <- 0
  loop :copy {
    if eq(i, len) {
      break :copy
    }

    write4(add(words, mul(i, 4)), 0)

    i <- add(i, 1)
  }
}

# STATE:

chunk_state_block_buffer_SIZE <- BLOCK_LEN()
alloc(chunk_state_block_buffer_SIZE)
chunk_state_block_buffer <- 0

words_16_SIZE <- mul(4, 16)
alloc(words_16_SIZE)
words_16 <- add(chunk_state_block_buffer_SIZE, chunk_state_block_buffer)

words_8_SIZE <- mul(4, 8)
alloc(words_8_SIZE)
words_8 <- add(words_16_SIZE, words_16)

IV_SIZE <- mul(4, 8)
alloc(IV_SIZE)
IV <- add(words_8_SIZE, words_8)

writeWord(IV, 0, 0x6A09E667)
writeWord(IV, 1, 0xBB67AE85)
writeWord(IV, 2, 0x3C6EF372)
writeWord(IV, 3, 0xA54FF53A)
writeWord(IV, 4, 0x510E527F)
writeWord(IV, 5, 0x9B05688C)
writeWord(IV, 6, 0x1F83D9AB)
writeWord(IV, 7, 0x5BE0CD19)

chaining_value_SIZE <- mul(4, 8)
alloc(chaining_value_SIZE)
chaining_value <- add(mul(4, 8), IV)

copyWords(IV, chaining_value, 8)

cv_stack_SIZE <- mul(mul(4, 8), 54)
alloc(cv_stack_SIZE)
cv_stack <- add(chaining_value_SIZE, chaining_value)

chunk_counter <- 0
chunk_state_block_len <- 0
blocks_compressed <- 0

cv_stack_len <- 0

loop :chunk_input {
}
for chunk_input in input.chunks(CHUNK_LEN) {
    if (BLOCK_LEN * blocks_compressed as usize + chunk_state_block_len as usize) <- CHUNK_LEN {
        # for (four_bytes, word) in chunk_state_block_buffer
        #     .as_chunks::<4>()
        #     .0
        #     .iter()
        #     .zip(mut words_16)
        # {
        #     *word <- u32::from_le_bytes(*four_bytes)
        # }

        total_chunks <- chunk_counter + 1

        words_8 <- first_8_words(compress(
            chaining_value,
            words_16,
            chunk_counter,
            chunk_state_block_len as u32,
            if blocks_compressed <- 0 {
                CHUNK_START
            } else {
                0
            } | CHUNK_END,
        ))

        total_chunks_ <- total_chunks
        while total_chunks_ & 1 <- 0 {
            cv_stack_len -<- 1
            words_16[..8].copy_from_slice(&cv_stack[cv_stack_len])
            words_16[8..].copy_from_slice(&words_8)
            words_8 <- first_8_words(compress(&IV, &words_16, 0, BLOCK_LEN as u32, PARENT))
            total_chunks_ >><- 1
        }

        copyWords(add(cv_stack, mul(cv_stack_len, mul(8, 4))), words_8)
        cv_stack_len <- add(cv_stack_len, 1)

        copyWords(IV, chaining_value, 8)
        chunk_counter <- total_chunks
        chunk_state_block_buffer <- [0; BLOCK_LEN]
        chunk_state_block_len <- 0
        blocks_compressed <- 0
    }

    # assert!(!chunk_input.is_empty() && chunk_input.len() <<- CHUNK_LEN)

    for chunk_block in chunk_input.chunks(BLOCK_LEN) {
        if chunk_state_block_len as usize <- BLOCK_LEN {
            for (four_bytes, word) in chunk_state_block_buffer
                .as_chunks::<4>()
                .0
                .iter()
                .zip(&mut words_16)
            {
                *word <- u32::from_le_bytes(*four_bytes)
            }
            chaining_value <- first_8_words(compress(
                chaining_value,
                words_16,
                chunk_counter,
                BLOCK_LEN as u32,
                if blocks_compressed <- 0 {
                    CHUNK_START
                } else {
                    0
                },
            ))
            blocks_compressed +<- 1
            chunk_state_block_buffer <- [0; BLOCK_LEN]
            chunk_state_block_len <- 0
        }

        chunk_state_block_buffer[chunk_state_block_len as usize..][..chunk_block.len()]
            .copy_from_slice(chunk_block)
        chunk_state_block_len +<- chunk_block.len() as u8
    }
}

output_flags <- 0
if blocks_compressed <- 0 {
    output_flags <- or(CHUNK_END, CHUNK_START)
} else {
    output_flags <- or(CHUNK_END)
}

