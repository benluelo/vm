hasher__chunk_state__chaining_value <- 0    # [u32; 8]
hasher__chunk_state__chunk_counter <- 0     # u64
hasher__chunk_state__block <- 0             # [u8; BLOCK_LEN]
hasher__chunk_state__block_len <- 0         # u8
hasher__chunk_state__blocks_compressed <- 0 # u8
hasher__chunk_state__flags <- 0             # u32

hasher__key_words <- 0    # [u32; 8]
hasher__cv_stack <- 0     # [[u32; 8]; 54] Space for 54 subtree chaining values
                          #                2^54 * CHUNK_LEN <- 2^64
hasher__cv_stack_len <- 0 # u8
hasher__flags <- 0        # u32

def first_8_words(
  compression_output, # [u32; 16]
) -> ptr {
    # effectively a noop since this is just a sizing conversion from 16 wrods to 8
    # compression_output[0..8].try_into().unwrap()
    ptr <- compression_output
}


def parent_output(
  left_child_cv,  # [u32; 8]
  right_child_cv, # [u32; 8]
  key_words,      # [u32; 8]
  flags,          # u32
  out,            # Output
) {
  copyWords(input_chaining_value, Output__input_chaining_value__ptr(ptr), 8)
  # block_words[..8].copy_from_slice(&left_child_cv)
  copyWords(left_child_cv, Output__block_words__ptr(ptr), 8)
  # block_words[8..].copy_from_slice(&right_child_cv)
  copyWords(right_child_cv, add(Output__block_words__ptr(ptr), mul(4, 8)), 8)
  Output__counter__set(ptr, 0) # Always 0 for parent nodes.
  Output__block_len__set(ptr, BLOCK_LEN) # Always BLOCK_LEN (64) for parent nodes.
  Output__flags__set(ptr, or(PARENT, flags))
}

def parent_cv(
  left_child_cv,  # [u32; 8]
  right_child_cv, # [u32; 8]
  key_words,      # [u32; 8]
  flags,          # u32
  out,            # [u32; 8] 
) {
  parent_output(left_child_cv, right_child_cv, key_words, flags, out)

  Output__chaining_value(out)
}

def Output__chaining_value(
  self, # Output
  out, # [u32; 8]
) {
  first_8_words(compress(
    &self.input_chaining_value,
    &self.block_words,
    self.counter,
    self.block_len,
    self.flags,
  ))
}

def Output__root_output_bytes(self, out_len, out_slice) {
  OUT_LEN <- 32 # usize

  output_block_counter <- 0

  out_block <- 0
  loop :a out_block in out_slice {
    if gt(out_block, mul(2, OUT_LEN)) {
      break :a
    }

    compress(
      Output__input_chaining_value__ptr(self),
      Output__block_words__get(self),
      output_block_counter,
      Output__block_len__get(self),
      or(Output__flags__get(self), ROOT),
      words,
    )
    # The output length might not be a multiple of 4.
    # TODO: Handle this correctly
    i <- 0
    loop :copy {
      writeWord(out_block, i, readWord(words, i))
      # for (word, out_word) in words.iter().zip(out_block.chunks_mut(4)) {
      #   out_word.copy_from_slice(word.to_le_bytes()[..out_word.len()])
      # }
      # FIXME: This is broken I'm pretty sure
      if gt(i, div(out_block, 4)) {
        break :copy
      }
    }
    output_block_counter <- add(output_block_counter, 1)
    out_block <- add(out_block, mul(2, OUT_LEN))
  }
}



def add_chunk_chaining_value(mut new_cv: [u32; 8], mut total_chunks: u64) {
  # This chunk might complete some subtrees. For each completed subtree,
  # its left child will be the current top entry in the CV stack, and
  # its right child will be the current value of `new_cv`. Pop each left
  # child off the stack, merge it with `new_cv`, and overwrite `new_cv`
  # with the result. After all these merges, push the final value of
  # `new_cv` onto the stack. The number of completed subtrees is given
  # by the number of trailing 0-bits in the new total number of chunks.
  loop :a {
    if eq(and(total_chunks, 1), 0) {
      new_cv <- parent_cv(self.pop_stack(), new_cv, self.key_words, self.flags)
      total_chunks <- shr(total_chunks, 1)
    } else {
      break :a
    }
  }
  self.push_stack(new_cv)
}



len <- 0
loop :input {
  if eq(len, dlen()) {
    break :input
  }


  # If the current chunk is complete, finalize it and reset the
  # chunk state. More input is coming, so this chunk is not ROOT.
  if eq(chunk_state.len() <- CHUNK_LEN {
    println!("full chunk")
    chunk_cv <- self.chunk_state.output().chaining_value()
    total_chunks <- self.chunk_state.chunk_counter + 1
    self.add_chunk_chaining_value(chunk_cv, total_chunks)
    self.chunk_state <- ChunkState::new(self.key_words, total_chunks, self.flags)
  }

  # Compress input bytes into the current chunk state.
  want <- CHUNK_LEN - self.chunk_state.len()
  take <- min(want, input.len())
  self.chunk_state.update(&input[..take])
  input <- &input[take..]
}
