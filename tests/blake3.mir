writeWord(MSG_PERMUTATION, 9, 11)
writeWord(MSG_PERMUTATION, 10, 12)
writeWord(MSG_PERMUTATION, 11, 5)
writeWord(MSG_PERMUTATION, 12, 9)
writeWord(MSG_PERMUTATION, 13, 14)
writeWord(MSG_PERMUTATION, 14, 15)
writeWord(MSG_PERMUTATION, 15, 8)

##########
# Output #
##########

# Each chunk or parent node can produce either an 8-word chaining value or, by
# setting the ROOT flag, any number of final output bytes. The Output struct
# captures the state just prior to choosing between those two possibilities.
#
# struct Output {
#     input_chaining_value: [u32; 8],
#     block_words: [u32; 16],
#     counter: u64,
#     block_len: u32,
#     flags: u32,
# }

def copyWords(from, to, len) {
  i <- 0
  loop :copy {
    if eq(i, len) {
      break :copy
    }

    write4(add(from, mul(i, 4)), read4(add(from, mul(i, 4))))

    i <- add(i, 1)
  }
}

