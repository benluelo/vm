def Output__input_chaining_value__ptr(ptr) -> arr_ptr {
  arr_ptr <- ptr
}

def Output__block_words__ptr(ptr) -> arr_ptr {
  arr_ptr <- add(ptr, mul(4, 8))
}

def Output__counter__get(ptr) -> counter {
  counter <- read8(add(ptr, add(mul(4, 8), mul(4, 16))))
}

def Output__counter__set(ptr, counter) {
  write8(add(ptr, add(mul(4, 8), mul(4, 16))), counter)
}

def Output__block_len__get(ptr) -> block_len {
  block_len <- read4(add(ptr, add(add(mul(4, 8), mul(4, 16)), 8)))
}

def Output__block_len__set(ptr, block_len) {
  write4(add(ptr, add(add(mul(4, 8), mul(4, 16)), 8)), block_len)
}

def Output__flags__get(ptr) -> flags {
  flags <- read4(add(ptr, add(add(add(mul(4, 8), mul(4, 16)), 8), 4)))
}

def Output__flags__set(ptr, flags) {
  write4(add(ptr, add(add(add(mul(4, 8), mul(4, 16)), 8), 4)), flags)
}

