# # Function to XOR into a 64-bit value using the little-endian (LE) convention.
# # On a LE platform, this could be greatly simplified using a cast.
def xor64(at, u) {
  # i <- 0
  # loop :a {
  #   write1(add(at, i), xor(u, read1(add(at, i))))
  #   u <- shr(u, 8)
  #   if eq(i, 7) {
  #     break :a
  #   }
  #   i <- add(i, 1)
  # }

  # write1(add(at, 0), xor(u, read1(add(at, 0))))
  # u <- shr(u, 8)
  # write1(add(at, 1), xor(u, read1(add(at, 1))))
  # u <- shr(u, 8)
  # write1(add(at, 2), xor(u, read1(add(at, 2))))
  # u <- shr(u, 8)
  # write1(add(at, 3), xor(u, read1(add(at, 3))))
  # u <- shr(u, 8)
  # write1(add(at, 4), xor(u, read1(add(at, 4))))
  # u <- shr(u, 8)
  # write1(add(at, 5), xor(u, read1(add(at, 5))))
  # u <- shr(u, 8)
  # write1(add(at, 6), xor(u, read1(add(at, 6))))
  # u <- shr(u, 8)
  # write1(add(at, 7), xor(u, read1(add(at, 7))))


  # write8(
  #   at,
  #   xor(
  #     read8(at),
  #     or(
  #       shl(or(
  #         and(shl(or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF)), 16), 0xFFFF0000FFFF0000),
  #         and(shr(or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF)), 16), 0x0000FFFF0000FFFF)
  #       ), 32),
  #       shr(or(
  #         and(shl(or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF)), 16), 0xFFFF0000FFFF0000),
  #         and(shr(or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF)), 16), 0x0000FFFF0000FFFF)
  #       ), 32)
  #     )
  #   )
  # )

  u <- or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF))
  u <- or(and(shl(u, 16), 0xFFFF0000FFFF0000), and(shr(u, 16), 0x0000FFFF0000FFFF))
  write8(at, xor(read8(at), or(shl(u, 32), shr(u, 32))))
  # write8(at, xor(read8(at), u))
}

def ROTL64(a, offset) -> n {
  # (a << offset) ^ (a >> (64-offset))
  n <- xor(shl(a, offset), shr(a, sub(64, offset)))
}

def i(x, y) -> n {
  # (x+5y)
  n <- add(x, mul(5, y))
}

def readLane(x, y) -> lane {
  lane <- load64(mul(8, i(x, y)))
}

def readLaneBE(x, y) -> lane {
  lane <- read8(mul(8, i(x, y)))
}

def writeLane(x, y, lane) {
  store64(mul(8, i(x, y)), lane)
}

def XORLane(x, y, lane) {
  xor64(mul(8, i(x, y)), lane)
}

# alloc state (1600 bits)
alloc(200)

# temp array[5] space (C during theta step, temp during chi step)
temp_arr_ptr <- 200
alloc(40)

# alloc blocks
block_count <- add(1, div(dlen(), 136))
# data starts after state and temp array
blocks_ptr <- add(200, 40)
alloc(mul(136, block_count))

# copy data to memory
dcopy(0, blocks_ptr, dlen())

# bits(input) + bits(0b01) + bits(0b1) + bits(0b1) + bits(n) + bits(0b1)
# write padding byte at the end of the copied input
write1(add(dlen(), blocks_ptr), 0x06)
# write trailing 1 bit to end of blocks
write1(
           add(sub(blocks_ptr, 1), mul(136, block_count)),
  or(read1(add(sub(blocks_ptr, 1), mul(136, block_count))), 0x80)
)

block_number <- 0
loop :blocks {
  if eq(block_number, block_count) {
    break :blocks
  }

  i <- 0
  loop :a {
    # 17 words per block
    if eq(i, 17) {
      break :a
    }
    # state_word <- read8(mul(i, 8))
    # # # start of blocks (200) + block offset + word offset
    # block_word <- read8(add(blocks_ptr, add(mul(block_number, 136), mul(i, 8))))
    write8(
      mul(i, 8),
      xor(
        read8(mul(i, 8)),
        read8(add(blocks_ptr, add(mul(block_number, 136), mul(i, 8))))
      )
    )
    i <- add(i, 1)
  }

  round <- 0
  x <- 0
  y <- 0
  j <- 0
  t <- 0
  loop :permute {
    if eq(round, 24) {
      break :permute
    }

    # === θ step (see [Keccak Reference, Section 2.3.2]) ===

    C <- temp_arr_ptr

    # Compute the parity of the columns
    x <- 0
    loop :theta_parity {
      if eq(x, 5) {
        break :theta_parity
      }
      # write to C[x]
      store64(
        add(C, mul(x, 8)),
        xor(xor(xor(xor(readLaneBE(x, 0), readLaneBE(x, 1)), readLaneBE(x, 2)), readLaneBE(x, 3)), readLaneBE(x, 4))
      )
      x <- add(x, 1)
    }

    x <- 0
    D <- 0
    loop :theta_effect_x {
      if eq(x, 5) {
        break :theta_effect_x
      }
      # Compute the θ effect for a given column
      D <- xor(
        # C[(x+4)%5]
        read8(add(C, mul(mod(add(x, 4), 5), 8))),
        # C[(x+1)%5]
        ROTL64(read8(add(C, mul(mod(add(x, 1), 5), 8))), 1)
      )

      # Add the θ effect to the whole column
      y <- 0
      loop :theta_effect_y {
        if eq(y, 5) {
          break :theta_effect_y
        }
        XORLane(x, y, D)
        y <- add(y, 1)
        # 1591140754
        # 1591810066
      }

      x <- add(x, 1)
    }

    # trap(1)

    # === ρ and π steps (see [Keccak Reference, Sections 2.3.3 and 2.3.4]) ===
    current <- 0
    temp <- 0
    # Start at coordinates (1 0)
    x <- 1
    y <- 0
    current <- readLane(x, y)
    # Iterate over ((0 1)(2 3))^t * (1 0) for 0 ≤ t ≤ 23
    t <- 0
    r <- 0
    Y <- 0
    loop :rho_and_pi {
      if eq(t, 24) {
        break :rho_and_pi
      }
      # Compute the rotation constant r = (t+1)(t+2)/2
      r <- mod(div(mul(add(t, 1), add(t, 2)), 2), 64)
      # # Compute ((0 1)(2 3)) * (x y)
      Y <- mod(add(mul(2, x), mul(3, y)), 5)
      x <- y
      y <- Y
      # Swap current and state(x,y), and rotate
      temp <- readLane(x, y)
      writeLane(x, y, ROTL64(current, r))
      current <- temp
      t <- add(t, 1)
    }

    # === χ step (see [Keccak Reference, Section 2.3.1]) ===
    y <- 0
    loop :chi {
      if eq(y, 5) {
        break :chi
      }
      # Take a copy of the plane
      x <- 0
      loop :chi_copy_plane {
        if eq(x, 5) {
          break :chi_copy_plane
        }
        write8(
          add(temp_arr_ptr, mul(x, 8)),
          readLane(x, y)
        )
        x <- add(x, 1)
      }
      # Compute χ on the plane
      x <- 0
      loop :chi_compute {
        if eq(x, 5) {
          break :chi_compute
        }
        writeLane(
          x, y,
          xor(
            read8(add(temp_arr_ptr, mul(x, 8))),
            and(
              neg(read8(add(temp_arr_ptr, mul(mod(add(x, 1), 5), 8)))),
                  read8(add(temp_arr_ptr, mul(mod(add(x, 2), 5), 8)))
            )
          )
        )
        x <- add(x, 1)
      }
      y <- add(y, 1)
    }

    # === ι step (see [Keccak Reference, Section 2.3.5]) ===
    # inlinedd iota round constants
    # TODO: Make these stack variables once I add arrays
    if eq(round, 0) {
      XORLane(0, 0, 0x0000000000000001)
    }
    if eq(round, 1) {
      XORLane(0, 0, 0x0000000000008082)
    }
    if eq(round, 2) {
      XORLane(0, 0, 0x800000000000808A)
    }
    if eq(round, 3) {
      XORLane(0, 0, 0x8000000080008000)
    }
    if eq(round, 4) {
      XORLane(0, 0, 0x000000000000808B)
    }
    if eq(round, 5) {
      XORLane(0, 0, 0x0000000080000001)
    }
    if eq(round, 6) {
      XORLane(0, 0, 0x8000000080008081)
    }
    if eq(round, 7) {
      XORLane(0, 0, 0x8000000000008009)
    }
    if eq(round, 8) {
      XORLane(0, 0, 0x000000000000008A)
    }
    if eq(round, 9) {
      XORLane(0, 0, 0x0000000000000088)
    }
    if eq(round, 10) {
      XORLane(0, 0, 0x0000000080008009)
    }
    if eq(round, 11) {
      XORLane(0, 0, 0x000000008000000A)
    }
    if eq(round, 12) {
      XORLane(0, 0, 0x000000008000808B)
    }
    if eq(round, 13) {
      XORLane(0, 0, 0x800000000000008B)
    }
    if eq(round, 14) {
      XORLane(0, 0, 0x8000000000008089)
    }
    if eq(round, 15) {
      XORLane(0, 0, 0x8000000000008003)
    }
    if eq(round, 16) {
      XORLane(0, 0, 0x8000000000008002)
    }
    if eq(round, 17) {
      XORLane(0, 0, 0x8000000000000080)
    }
    if eq(round, 18) {
      XORLane(0, 0, 0x000000000000800A)
    }
    if eq(round, 19) {
      XORLane(0, 0, 0x800000008000000A)
    }
    if eq(round, 20) {
      XORLane(0, 0, 0x8000000080008081)
    }
    if eq(round, 21) {
      XORLane(0, 0, 0x8000000000008080)
    }
    if eq(round, 22) {
      XORLane(0, 0, 0x0000000080000001)
    }
    if eq(round, 23) {
      XORLane(0, 0, 0x8000000080008008)
    }

    round <- add(round, 1)
  
  }

  block_number <- add(block_number, 1)
}

exit(0, 32)
