# Function to load a 64-bit value using the little-endian (LE) convention.
# On a LE platform, this could be greatly simplified using a cast.
def load64(at) -> u {
  # i <- 7
  # loop :a {
  #   u <- shl(u, 8)
  #   u <- or(u, read1(add(at, i)))
  #   if eq(i, 0) {
  #     break :a
  #   }
  #   i <- sub(i, 1)
  # }

  # u <- or(shl(or(shl(or(shl(or(shl(or(shl(or(shl(or(shl(read1(add(at, 7)), 8), read1(add(at, 6))), 8), read1(add(at, 5))), 8), read1(add(at, 4))), 8), read1(add(at, 3))), 8), read1(add(at, 2))), 8), read1(add(at, 1))), 8), read1(add(at, 0)))
  # u <- u

  # u <- or(u, read1(add(at, 7)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 6)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 5)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 4)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 3)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 2)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 1)))
  # u <- shl(u, 8)
  # u <- or(u, read1(add(at, 0)))

  u <- read8(at)
  u <- or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF))
  u <- or(and(shl(u, 16), 0xFFFF0000FFFF0000), and(shr(u, 16), 0x0000FFFF0000FFFF))
  u <- or(shl(u, 32), shr(u, 32))
}

# Function to store a 64-bit value using the little-endian (LE) convention.
# On a LE platform, this could be greatly simplified using a cast.
def store64(at, u) {
  # i <- 0
  # loop :a {
  #   write1(add(at, i), u)
  #   u <- shr(u, 8)
  #   if eq(i, 7) {
  #     break :a
  #   }
  #   i <- add(i, 1)
  # }

  # write1(add(at, 0), u)
  # u <- shr(u, 8)
  # write1(add(at, 1), u)
  # u <- shr(u, 8)
  # write1(add(at, 2), u)
  # u <- shr(u, 8)
  # write1(add(at, 3), u)
  # u <- shr(u, 8)
  # write1(add(at, 4), u)
  # u <- shr(u, 8)
  # write1(add(at, 5), u)
  # u <- shr(u, 8)
  # write1(add(at, 6), u)
  # u <- shr(u, 8)
  # write1(add(at, 7), u)

  u <- or(and(shl(u, 8),  0xFF00FF00FF00FF00), and(shr(u, 8),  0x00FF00FF00FF00FF))
  u <- or(and(shl(u, 16), 0xFFFF0000FFFF0000), and(shr(u, 16), 0x0000FFFF0000FFFF))
  write8(at, or(shl(u, 32), shr(u, 32)))
  # write8(at, u)
}

