def load64(at) -> u {
  u <- read8(at)
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
}
def store64(at, u) {
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
  write8(at, u)
}
def xor64(at, u) {
  u <- or(and(shl(u, 8), 18374966859414961920), and(shr(u, 8), 71777214294589695))
  u <- or(and(shl(u, 16), 18446462603027742720), and(shr(u, 16), 281470681808895))
  u <- or(shl(u, 32), shr(u, 32))
  write8(at, xor(read8(at), u))
}
def ROTL64(a, offset) -> n {
  n <- xor(shl(a, offset), shr(a, sub(64, offset)))
}
def i(x, y) -> n {
  n <- add(x, mul(5, y))
}
def readLane(x, y) -> lane {
  lane <- load64(mul(8, add(x, mul(5, y))))
}
def writeLane(x, y, lane) {
  store64(mul(8, add(x, mul(5, y))), lane)
}
def XORLane(x, y, lane) {
  xor64(mul(8, add(x, mul(5, y))), lane)
}
alloc(200)
temp_arr_ptr <- 200
alloc(40)
round_constants_ptr <- 240
alloc(192)
write8(240, 1)
write8(248, 32898)
write8(256, 9223372036854808714)
write8(264, 9223372039002292224)
write8(272, 32907)
write8(280, 2147483649)
write8(288, 9223372039002292353)
write8(296, 9223372036854808585)
write8(304, 138)
write8(312, 136)
write8(320, 2147516425)
write8(328, 2147483658)
write8(336, 2147516555)
write8(344, 9223372036854775947)
write8(352, 9223372036854808713)
write8(360, 9223372036854808579)
write8(368, 9223372036854808578)
write8(376, 9223372036854775936)
write8(384, 32778)
write8(392, 9223372039002259466)
write8(400, 9223372039002292353)
write8(408, 9223372036854808704)
write8(416, 2147483649)
write8(424, 9223372039002292232)
block_count <- add(1, div(dlen(), 136))
blocks_ptr <- 432
alloc(mul(136, block_count))
dcopy(0, 432, dlen())
write1(add(dlen(), 432), 6)
write1(add(431, mul(136, block_count)), or(read1(add(431, mul(136, block_count))), 128))
block_number <- 0
loop :blocks {
  blocks_ptr <- 432
  temp_arr_ptr <- 200
  round_constants_ptr <- 240
  if eq(block_number, block_count) {
    break :blocks
  }
  i <- 0
  loop :a {
    if eq(i, 17) {
      break :a
    }
    write8(mul(i, 8), xor(read8(mul(i, 8)), read8(add(432, add(mul(block_number, 136), mul(i, 8))))))
    i <- add(i, 1)
  }
  round <- 0
  x <- 0
  y <- 0
  j <- 0
  t <- 0
  loop :permute {
    if eq(round, 24) {
      break :permute
    }
    C <- 200
    x <- 0
    loop :theta_parity {
      if eq(x, 5) {
        break :theta_parity
      }
      write8(add(200, mul(x, 8)), xor(xor(xor(xor(load64(mul(8, x)), load64(mul(8, add(x, 5)))), load64(mul(8, add(x, 10)))), load64(mul(8, add(x, 15)))), load64(mul(8, add(x, 20)))))
      x <- add(x, 1)
    }
    x <- 0
    D <- 0
    loop :theta_effect_x {
      if eq(x, 5) {
        break :theta_effect_x
      }
      D <- xor(read8(add(200, mul(mod(add(x, 4), 5), 8))), xor(shl(read8(add(200, mul(mod(add(x, 1), 5), 8))), 1), shr(read8(add(200, mul(mod(add(x, 1), 5), 8))), 63)))
      y <- 0
      loop :theta_effect_y {
        if eq(y, 5) {
          break :theta_effect_y
        }
        xor64(mul(8, add(x, mul(5, y))), D)
        y <- add(y, 1)
      }
      x <- add(x, 1)
    }
    current <- 0
    temp <- 0
    x <- 1
    y <- 0
    current <- load64(8)
    t <- 0
    r <- 0
    Y <- 0
    loop :rho_and_pi {
      if eq(t, 24) {
        break :rho_and_pi
      }
      r <- mod(div(mul(add(t, 1), add(t, 2)), 2), 64)
      Y <- mod(add(mul(2, x), mul(3, y)), 5)
      x <- y
      y <- Y
      temp <- load64(mul(8, add(x, mul(5, y))))
      store64(mul(8, add(x, mul(5, y))), xor(shl(current, r), shr(current, sub(64, r))))
      current <- temp
      t <- add(t, 1)
    }
    y <- 0
    loop :chi {
      if eq(y, 5) {
        break :chi
      }
      x <- 0
      loop :chi_copy_plane {
        if eq(x, 5) {
          break :chi_copy_plane
        }
        write8(add(200, mul(x, 8)), load64(mul(8, add(x, mul(5, y)))))
        x <- add(x, 1)
      }
      x <- 0
      loop :chi_compute {
        if eq(x, 5) {
          break :chi_compute
        }
        store64(mul(8, add(x, mul(5, y))), xor(read8(add(200, mul(x, 8))), and(neg(read8(add(200, mul(mod(add(x, 1), 5), 8)))), read8(add(200, mul(mod(add(x, 2), 5), 8))))))
        x <- add(x, 1)
      }
      y <- add(y, 1)
    }
    xor64(0, read8(add(mul(8, round), 240)))
    round <- add(round, 1)
  }
  block_number <- add(block_number, 1)
}
exit(0, 32)
